[
  {
    "id": -1,
    "enable": true,
    "name": "中文标准章节（第N章 / 第N回 / 第N节）",
    "rule": "^[\\s\\u3000]{0,4}第\\s{0,4}[\\d〇零一二两三四五六七八九十百千万壹贰叁肆伍陆柒捌玖拾佰仟]{1,8}\\s{0,4}(?:章|回|节(?!课)|卷|集(?![合和])|话|篇|部|场)(?![\\u4e00-\\u9fa5])[\\s\\u3000]{0,4}.{0,40}$",
    "example": "第一章 山门之外",
    "serialNumber": 0
  },
  {
    "id": -2,
    "enable": true,
    "name": "中文无标题章节（只有 第N章）",
    "rule": "^[\\s\\u3000]{0,4}第\\s{0,4}[\\d〇零一二两三四五六七八九十百千万壹贰叁肆伍陆柒捌玖拾佰仟]{1,8}\\s{0,4}(?:章|回|节|卷|集|话|篇|部)\\s{0,4}$",
    "example": "第十二章",
    "serialNumber": 1
  },
  {
    "id": -4,
    "enable": true,
    "name": "古典/轻小说卷首（序章/楔子/尾声/番外）",
    "rule": "^[\\s\\u3000]{0,4}(?:序章|序言|楔子|引子|尾声|终章|后记|番外|外传|番外篇)\\s{0,4}.{0,30}$",
    "example": "序章 雪落无声",
    "serialNumber": 2
  },
  {
    "id": -8,
    "enable": true,
    "name": "阿拉伯数字前缀（1、标题 / 1. 标题）",
    "rule": "^[\\s\\u3000]{0,4}\\d{1,4}\\s{0,2}[、.．，:：]\\s{0,4}\\S.{0,40}$",
    "example": "1、初入江湖",
    "serialNumber": 3
  },
  {
    "id": -12,
    "enable": true,
    "name": "英文章节（Chapter N / Section N / Part N）",
    "rule": "^[\\s\\u3000]{0,4}(?:[Cc]hapter|[Ss]ection|[Pp]art|[Ee]pisode)\\s{0,4}\\d{1,6}\\s{0,4}[:.、\\-—]?\\s{0,4}.{0,40}$",
    "example": "Chapter 12 The Gate",
    "serialNumber": 4
  },
  {
    "id": -14,
    "enable": false,
    "name": "【激进·默认关闭】成对符号标题（《…》/「…」/【…】）",
    "rule": "^[\\s\\u3000]{0,4}[《〈「『【〖〔（(].{1,30}[》〉」』】〗〕）)]\\s{0,4}$",
    "example": "《这么可爱真是抱歉》",
    "serialNumber": 5
  },
  {
    "id": -22,
    "enable": false,
    "name": "【激进·默认关闭】特定符号分隔标题（=== 标题 ===）",
    "rule": "^[\\s\\u3000]{0,4}[=\\-—*~#]{3,}\\s{0,4}.{0,40}\\s{0,4}[=\\-—*~#]{3,}$",
    "example": "========== 第一卷 ==========",
    "serialNumber": 6
  },
  {
    "id": -17,
    "enable": false,
    "name": "【激进·默认关闭】顶格短行（无序号，任意顶格 2~20 字行）",
    "rule": "^\\S.{1,20}$",
    "example": "夜访",
    "serialNumber": 7
  },
  {
    "id": -24,
    "enable": false,
    "name": "【激进·默认关闭】通用宽泛规则",
    "rule": "(?im)^.{0,6}(?:[引楔]子|正文(?!完|结)|[引序前]言|[序终]章|扉页|[上中下][部篇卷]|卷首|卷尾).{0,30}$",
    "example": "正文 第一章",
    "serialNumber": 8
  }
]
